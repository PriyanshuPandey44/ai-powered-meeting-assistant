# --- Database (MongoDB Atlas connection string) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meeting-assistant?retryWrites=true&w=majority

# --- AI provider: "gemini" (free tier available) or "openai" ---
AI_PROVIDER=gemini

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local server port (not needed on Vercel)
PORT=5000
